{
  "name": "localforge-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LocalForge single-page application built with React and Tailwind CSS",
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint --max-warnings 0 .",
    "types": "tsc -b && node scripts/generate-api.ts --check",
    "docs": "node scripts/check-docs.ts",
    "api:generate": "node scripts/generate-api.ts",
    "test": "vitest run --coverage",
    "build": "vite build && node scripts/check-bundle.ts",
    "e2e": "pnpm run build && playwright test",
    "audit:supply": "node scripts/audit-supply-chain.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "msw": "3.0.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.21.0"
}
